# Translator Environment Variables
# Copy this file to .env and fill in your actual API keys
#
# Configuration file search paths (in priority order):
#   1. Executable directory
#   2. Current working directory
#   3. Global config file directory
#
# IMPORTANT: This file should ONLY contain sensitive data (API keys, secrets).
# All other configuration (rate limits, timeouts, URLs, etc.) should be in translator.toml

# =============================================================================
# API Keys and Secrets (Sensitive Data Only)
# =============================================================================

# DeepLX API URL (may contain sensitive information like embedded API keys)
# Example: https://api.deeplx.org or your self-hosted instance
DEEPLX_API_URL=https://api.deeplx.org

# DeepLX API Key (optional, for authenticated requests)
# The API key will be embedded in the URL as: https://api.deeplx.org/<api-key>/translate
DEEPLX_API_KEY=your-api-key-here

# LLM Provider Specific API Keys (for use in translator.toml)
# SiliconFlow
SILCON_API_KEY=xxx

# Zhipu AI
ZHIPU_API_KEY=xxx

# OpenAI
OPENAI_API_KEY=sk-xxx

# Azure OpenAI
AZURE_API_KEY=xxx
AZURE_ENDPOINT=https://your-resource.openai.azure.com/

# Tencent Cloud Credentials
TENCENT_SECRET_ID=xxx
TENCENT_SECRET_KEY=xxx
